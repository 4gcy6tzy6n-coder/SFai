# Copy to .env for local runs. Core correctness tests never read these.
# Model provider (OpenAI-compatible endpoint) — live HTTP client is a M1 remaining item.
SFAI_MODEL_BASE_URL=
SFAI_MODEL_API_KEY=
SFAI_MODEL_NAME=

# Runtime storage root (SQLite db, content-addressed blobs, traces).
SFAI_STORAGE_ROOT=.sfai
